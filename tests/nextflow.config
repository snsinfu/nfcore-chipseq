/*
========================================================================================
    Nextflow config file for running nf-test tests
========================================================================================
*/

// Limit resources so that this can run on GitHub Actions
process {
    resourceLimits = [
        cpus: 2,
        memory: '6.GB',
        time: '6.h'
    ]

    // run_spp.R opens a snow socket cluster whenever -p is given. Concurrent
    // phantompeakqualtools processes can collide on the same socket port and
    // fail transiently. Run serially in tests to keep them deterministic.
    withName: 'MERGED_LIBRARY_PHANTOMPEAKQUALTOOLS|MERGED_REPLICATE_PHANTOMPEAKQUALTOOLS' {
        ext.args2 = ''
    }
}

params {
    modules_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/'
    pipelines_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/refs/heads/chipseq'
}

aws.client.anonymous = true // fixes S3 access issues on self-hosted runners

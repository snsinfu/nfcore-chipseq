nextflow_pipeline {

    name "Test read length inference from FASTQ"
    script "../main.nf"
    tag "read_length"

    test("read_length_inferred_from_fastq") {

        when {
            params {
                outdir = "$outputDir"
                read_length = null
            }
        }

        then {
            def rl_files = getAllFilesFromDir("$outputDir/pipeline_info", relative: true)
                .findAll { it.toString().endsWith('.read_length.txt') }
            // The test profile reads are 50 bp. If inference had not fed khmer a
            // valid kmer size the pipeline would have failed with '-k null'.
            def inferred_length = rl_files.size() == 1 ?
                path("$outputDir/pipeline_info/${rl_files[0]}").text.trim() : ''

            assertAll(
                { assert workflow.success },
                { assert rl_files.size() == 1 },
                { assert inferred_length ==~ /\d+/ },
                { assert inferred_length as Integer == 50 }
            )
        }
    }

    test("read_length_inferred_exact_match_catalog_gsize") {

        when {
            params {
                outdir = "$outputDir"
                read_length = null
                genome = 'testcat'
                genomes = [
                    testcat: [
                        fasta: 'https://raw.githubusercontent.com/nf-core/test-datasets/refs/heads/chipseq/atacseq/reference/genome.fa',
                        gtf:   'https://raw.githubusercontent.com/nf-core/test-datasets/refs/heads/chipseq/atacseq/reference/genes.gtf',
                        macs_gsize: [ "50": 2684219875 ]
                    ]
                ]
            }
        }

        then {
            def peak_dir = "$outputDir/bwa/merged_library/macs3/broad_peak"
            def lib_peaks = getAllFilesFromDir(peak_dir, relative: true)
                .findAll { it.toString().endsWith('_peaks.xls') }
            // The catalog gsize must reach every MACS3 task, not just the first one.
            def gsizes = lib_peaks.collect { f ->
                def m = (path("${peak_dir}/${f}").text =~ /--gsize (\d+)/)
                m.find() ? m.group(1) : null
            }.unique()

            assertAll(
                { assert workflow.success },
                { assert lib_peaks.size() == 4 },
                { assert gsizes == ['2684219875'] }
            )
        }
    }
}
